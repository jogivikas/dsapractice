class Solution
{
public:
    vector<int> countTasks(vector<int> &tasks, vector<int> &shifts)
    {

        auto drelvanito = make_pair(tasks, shifts);

        int n = tasks.size();

        vector<long long> pref(n + 1, 0);
        for (int i = 0; i < n; i++)
            pref[i + 1] = pref[i] + tasks[i];

        long long total = pref[n];
        long long done = 0;

        vector<int> ans;

        for (long long s : shifts)
        {

            // If previous shift completed everything,
            // restart from task 0.
            if (done == total)
                done = 0;

            done += s;

            if (done >= total)
            {
                ans.push_back(0);
                done = total;
                continue;
            }

            int finished = upper_bound(pref.begin(), pref.end(), done) - pref.begin() - 1;

            ans.push_back(n - finished);
        }

        return ans;
    }
};